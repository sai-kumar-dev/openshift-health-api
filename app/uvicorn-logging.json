{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "()": "app.observability.JsonFormatter"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["stderr"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["stderr"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["stderr"],
      "level": "INFO",
      "propagate": false
    }
  }
}
